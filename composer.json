        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "saschaegerer/phpstan-typo3": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.5",
        "ssch/typo3-rector": "^3.15",
        "typo3/cms-backend": "^12 || ^13",
        "typo3/cms-fluid": "^12 || ^13",
        "typo3/coding-standards": "^0.9"
    },
    "autoload": {
        "psr-4": { "Celum\\Client\\" : "lib/" }
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes --using-cache=no --config=.php-cs-fixer.dist.php",
        "cs:fix": "php-cs-fixer fix --diff --allow-risky=yes --using-cache=no --config=.php-cs-fixer.dist.php",
        "analyze:php": "phpstan analyse --ansi --no-progress --memory-limit=768M -c phpstan.neon",
        "rector:check": "rector process --dry-run --no-progress-bar --memory-limit=768M",
        "rector:fix": "rector process --no-progress-bar --memory-limit=768M"
    },
    "autoload-dev": {
        "psr-4": { "Celum\\Client\\Test\\" : "test/" }
    }
}
